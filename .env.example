# Backend environment variables (set these in your shell or IDE run configuration).
# Nothing here is required for a default local setup except the MySQL password.

DB_URL=jdbc:mysql://localhost:3306/currency_exchange?createDatabaseIfNotExist=true&serverTimezone=UTC&rewriteBatchedStatements=true
DB_USERNAME=root
DB_PASSWORD=change-me

# Optional. Empty = ExchangeRate-API keyless open-access endpoint (updates once per day).
EXCHANGE_RATE_API_KEY=

# true = seed clearly labelled synthetic history so charts can be demonstrated immediately.
DEMO_DATA_ENABLED=true

# Frontend origin allowed to call the API directly (the Vite dev proxy does not need this).
CORS_ORIGINS=http://localhost:5173
